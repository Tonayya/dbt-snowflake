# The rules specified here should be at least as strict as,
# preferably stricter than, and consistent with those in the
# lint repo .sqlfluff that it overrides.

[sqlfluff]
exclude_rules = ambiguous.join, structure.column_order, structure.using
max_line_length = 120
templater = dbt

[sqlfluff:templater]
unwrap_wrapped_queries = true

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:templater:dbt]
profile = default
profiles_dir = /.dbt
project_dir = /sql
target = dev

[sqlfluff:indentation]
indent_unit = space
indented_joins = True
tab_space_size = 4
template_blocks_indent = True

[sqlfluff:layout:type:comma]
line_position = leading
spacing_before = touch

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:layout.spacing]

[sqlfluff:rules:references.keywords]
ignore_words = first_name,last_name